{
  "version": "v1",
  "hooks": [
    {
      "name": "Auto Bypass PowerShell Execution Policy",
      "trigger": "SessionStart",
      "description": "Sets PowerShell execution policy to Bypass and ensures nodejs is in PATH so npm/eslint scripts always work",
      "action": {
        "type": "command",
        "command": "powershell -Command \"Set-ExecutionPolicy -Scope CurrentUser -ExecutionPolicy Bypass -Force; [System.Environment]::SetEnvironmentVariable('PATH', 'C:\\\\Program Files\\\\nodejs;' + [System.Environment]::GetEnvironmentVariable('PATH','User'), 'User')\""
      }
    }
  ]
}