# ============================================================================
# SECURITY HEADERS (Cloudflare Pages reads this file automatically)
# Ye headers browser ko batate hain site ko safely load kare -> XSS, clickjacking,
# MIME-sniffing jaise attacks se bachaav. Static site pe ye extra hardening hai.
# ============================================================================

/*
  # Site ko iframe me embed hone se roko (clickjacking se bachaav)
  X-Frame-Options: SAMEORIGIN
  # Browser ko file type guess karne se roko (MIME-sniffing attack se bachaav)
  X-Content-Type-Options: nosniff
  # Referrer info leak kam karo
  Referrer-Policy: strict-origin-when-cross-origin
  # Purani powerful browser features band rakho
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  # HTTPS force karo (1 saal), subdomains bhi
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Content Security Policy — sirf trusted sources se script/style load ho.
  # Sirf Google Analytics (GA4) ke domains allow. Naya third-party script (affiliate widget,
  # tip jar) lagao to yahan uska domain jodna padega, warna browser block karega.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

# Private pages: never index (admin panel is also protected by Cloudflare Access)
/admin/*
  X-Robots-Tag: noindex, nofollow
/my-money/*
  X-Robots-Tag: noindex
