{
  "name": "calcivy",
  "version": "1.0.0",
  "private": true,
  "description": "CalcIvy - Free online financial calculators for the US. Paycheck, mortgage payoff, debt payoff, auto loan, percentage, and compound interest calculators.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "prebuild": "node scripts/check-tools.mjs && node scripts/gen-ads-txt.mjs",
    "build": "next build",
    "postbuild": "node scripts/fix-rsc-prefetch.mjs",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "check-tools": "node scripts/check-tools.mjs",
    "agent:daily": "node scripts/agent/daily.mjs"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/node": "20.14.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "3.4.6",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
